# Firefly III — variables de entorno (historia 0.1)
#
# Copiar a `.env` (nunca commitear ese archivo) y completar con valores reales.
# `.env` queda excluido vía infra/.gitignore.

# --- Base de datos (MariaDB) ---
# Nombre de la base, usuario y password que usará Firefly III para conectarse.
# Elegí un password fuerte — es la instancia que guarda tus datos financieros.
DB_DATABASE=firefly
DB_USERNAME=firefly
DB_PASSWORD=changeme_use_a_strong_password

# --- Aplicación Firefly III ---
# APP_KEY debe ser una cadena exactamente de 32 caracteres (o "base64:" + 44
# caracteres). Generarla con:
#   docker run --rm fireflyiii/core:latest artisan key:generate --show
# y pegar el resultado completo acá (incluyendo el prefijo "base64:" si lo trae).
APP_KEY=

# URL pública desde donde se accede a Firefly III. Actualizar a
# "https://<tu-dominio>" una vez configurado el proxy host + certificado en
# Nginx Proxy Manager (historia 0.2) — Firefly usa este valor para generar
# links y validar el origen de las requests.
APP_URL=http://localhost:8081

# Zona horaria de la instancia (afecta fechas de transacciones y reportes).
TZ=America/Bogota

# Puerto local donde se publica Firefly III de forma directa (temporal, ver
# nota en docker-compose.yml — se retira una vez confirmado el HTTPS vía NPM).
FIREFLY_HTTP_PORT=8081

# --- Reverse proxy (historia 0.2) ---
# Dominio/subdominio que apunta (registro DNS A) a la IP de este servidor.
# El reverse proxy que lo expone es el nginx del sistema operativo (fuera de
# este compose) -- ver infra/README.md. Ej: firefly.tudominio.com
FIREFLY_DOMAIN=firefly.nyoholding.com

# Necesario para que Firefly genere URLs/redirects en HTTPS (no HTTP) al
# estar detrás del nginx del host. "**" = confiar en cualquier proxy; seguro
# acá porque el puerto de Firefly solo es alcanzable desde 127.0.0.1.
TRUSTED_PROXIES=**

# --- Postgres del Bot Service (historia 0.3) ---
# Base de datos separada de la de Firefly III de arriba -- guarda usuarios
# autorizados/PAT cifrado (Épica 1) y auditoría de IA (Épica 8), no datos
# financieros. Elegí un password fuerte, distinto del de Firefly.
BOT_DB_DATABASE=bot_asistente_gastos
BOT_DB_USERNAME=bot_asistente_gastos
BOT_DB_PASSWORD=changeme_use_a_strong_password

# Puerto donde se publica este Postgres en 127.0.0.1 (nunca en 0.0.0.0) para
# que el Bot Service, que corre como proceso pm2 en el host y no dentro de
# este compose, pueda conectarse. Default 5433 (no 5432) para no chocar con
# un Postgres que ya pueda existir en esta VPS por otro de tus proyectos.
BOT_DB_PORT=5433

# --- Redis del Bot Service (historia 0.3) ---
# Historial de conversación (Épica 5) y cola de procesamiento (Épica 6).
# Mismo criterio que arriba: puerto no estándar (6380, no 6379) para evitar
# colisión con otro Redis ya corriendo en esta VPS.
BOT_REDIS_PORT=6380

# --- MCP de Firefly III (historia 4.1) ---
# Puerto donde se publica el servicio mcp-firefly en 127.0.0.1 (nunca en
# 0.0.0.0) -- el Bot Service, que corre como proceso pm2 en el host, lo
# alcanza por localhost. Default 3100 para no chocar con el puerto por
# defecto del propio paquete (3000) ni con otro proyecto de esta VPS.
# A propósito NO hay FIREFLY_III_PAT/FIREFLY_III_BASE_URL acá: este servicio
# es multi-tenant por-request, las credenciales viajan por header en cada
# llamada (ver mcp/README.md) -- fijarlas lo volvería mono-tenant.
MCP_FIREFLY_PORT=3100

# Bot Service — variables de entorno (historia 2.1)
#
# Copiar a `.env` (nunca commitear ese archivo) y completar con valores reales.
# `.env` queda excluido vía el .gitignore de la raíz del repo.

# Token del bot obtenido de @BotFather (guardarlo acá, nunca hardcodeado en el código).
TELEGRAM_BOT_TOKEN=

# Valor propio (no lo genera Telegram) que se envía a `setWebhook` y que Telegram
# reenvía en cada request en el header `X-Telegram-Bot-Api-Secret-Token`. Generarlo
# con algo como: openssl rand -hex 32
TELEGRAM_WEBHOOK_SECRET=

# Ruta del endpoint que recibe los updates de Telegram.
WEBHOOK_PATH=/webhook/telegram

# URL pública HTTPS (dominio/subdominio del Bot Service, vía el nginx del sistema
# operativo + certbot — mismo patrón que Firefly III en la historia 0.2). Solo la
# usa `scripts/set-webhook.ts` para registrar el webhook contra la API de Telegram.
# Ej: https://bot.firefly.nyoholding.com
PUBLIC_URL=

# Puerto local donde escucha el Bot Service. El nginx del host lo expone al público
# por HTTPS — igual que Firefly III, nunca publicar este puerto en 0.0.0.0.
PORT=3001

# Nivel de log estructurado (historia 8.1): debug | info | warn | error.
# Un valor ausente o inválido cae a "info" sin romper el arranque.
LOG_LEVEL=info

# Conexión al Postgres dedicado al Bot Service (historia 0.3 — infra/docker-compose.yml).
# Debe coincidir con BOT_DB_USERNAME/BOT_DB_PASSWORD/BOT_DB_DATABASE/BOT_DB_PORT
# de infra/.env. Publicado en 127.0.0.1 (no en la red pública) porque este
# proceso corre en el host, no dentro del compose.
DATABASE_URL=postgresql://bot_asistente_gastos:changeme_use_a_strong_password@127.0.0.1:5433/bot_asistente_gastos

# Clave simétrica AES-256-GCM para cifrar el PAT de cada usuario en reposo
# (historia 1.4). Requerida: el proceso no arranca sin ella ni con un largo
# incorrecto. 64 caracteres hex (32 bytes). Generarla con:
#   openssl rand -hex 32
# Vive SOLO en el .env del servidor -- nunca en el repo, nunca en un chat. Si
# se pierde o rota, todos los PAT ya guardados quedan indescifrables (ver
# historia de rotación de secretos, Epic 8, HU-33 -- fuera de alcance acá).
PAT_ENCRYPTION_KEY=

# Conexión al Redis dedicado al Bot Service (historia 0.3). Debe coincidir con
# BOT_REDIS_PORT de infra/.env. Sin uso todavía (historial de Épica 5, cola de
# Épica 6) — se deja disponible ahora que el servicio ya existe.
REDIS_URL=redis://127.0.0.1:6380

# Alta de usuarios en Firefly III (historia 1.3) — SOLO los usa
# `npm run alta-usuario`, ejecutado a mano por el administrador. El proceso
# del bot (webhook) nunca los lee ni los necesita para arrancar.
# FIREFLY_ADMIN_TOKEN es el PAT de rol "owner" de la instancia de Firefly III
# -- máximo privilegio, nunca commitear, nunca pegarlo en un chat.
FIREFLY_ADMIN_BASE_URL=https://firefly.nyoholding.com
FIREFLY_ADMIN_TOKEN=
